# Maintained in this repository (ADR-0132 D1: the public repository is the upstream; the assembler is retired).
# The engine image — runs `cairn-server` (ADR-0029 Channel C).
#
# Multi-stage: uv resolves the full workspace (engine + all operator wheels,
# non-editable) into a venv; the runtime stage carries only python + the venv.
# Published as ghcr.io/cairndev-sh/cairn-engine:<version> (release.yml).
#
#   docker build -f Dockerfile.engine -t cairn-engine .
#
# Auth on (the server then binds 0.0.0.0 inside the container):
#   docker run --rm -p 9090:9090 -e CAIRN_JWT_SECRET="$(openssl rand -hex 32)" \
#     -e CAIRN_API_PASSWORD=<choose one> -e OPENAI_API_KEY=sk-... cairn-engine
# A keyless trial (auth off): the server binds 127.0.0.1 unless told otherwise, so say so
# and publish on the host's loopback only:
#   docker run --rm -p 127.0.0.1:9090:9090 -e CAIRN_TRIGGER_HOST=0.0.0.0 cairn-engine
# The profile defaults to the packaged `secure` one (CMD below); runs are kept in memory
# unless CAIRN_STORAGE is set (sqlite:///<path on a volume> or postgres://…).

# ---------------------------------------------------------------------------
# #1761 — LAYER ORDER. `uv sync --all-packages` needs a pyproject.toml for
# EVERY workspace member (45: root + client/ask/sdk + 36 operator packs + the 5
# contract distributions under contracts/, #2241 D / #2242 V1-B) or the
# install plan fails outright. That used to be satisfied by copying the whole
# source tree ABOVE the sync, which put every .py/.toml/.yaml in the dependency
# layer's cache key: a one-line edit to a profile under `cairn/profiles/` re-ran the
# full 372s install and re-exported the ~7GB venv layer (measured on the
# 2-vCPU prod box, 2026-08-28).
#
# So: stage `manifests` prunes the context down to the manifests ALONE, the
# builder installs third-party deps from those, and only THEN does source
# arrive. `COPY --from=manifests` is content-addressed by BuildKit, so the
# heavy sync stays cached until uv.lock or a pyproject.toml actually changes.
# ---------------------------------------------------------------------------

# Debian trixie (not bookworm): bookworm ships libsqlite3 3.40.1, which DBOS
# v2.23.0's SQLite system-DB inserts can't run against (NOT NULL timestamp
# failures); trixie ships ~3.46, matching the version that works locally.
# See an internal issue. Both stages must match so the venv's python links the
# same libsqlite3 at runtime.
FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim AS manifests
WORKDIR /src
COPY pyproject.toml uv.lock README.md ./
# The members under packages/ (the client and the optional operator packs). Copying
# the whole subtree here costs nothing in the final image (this stage is
# discarded) and lets the find below track [tool.uv.workspace] automatically. The
# builtin operator packs and the core contracts under packages/ are not members: the
# engine wheel carries them (ADR-0137 D2), so only the builder stage needs their source.
COPY packages ./packages
# The example pack is a workspace member too (examples/hello-cairn, #2693): its manifest is
# staged here as well as its source in the builder stage.
COPY examples ./examples
# A `find` rather than 41 explicit COPY lines, so a new workspace member UNDER THE
# DIRECTORIES COPIED ABOVE is picked up automatically. A member anywhere else needs a
# COPY here AND in the builder stage, or the deps sync fails; the public tree's test
# (tests/scripts/test_assemble_public_tree.py) checks both stages. Anything the find
# sweeps up that is absent from [tool.uv.workspace] is harmless: uv ignores it.
# POSIX `mkdir -p`/`cp` rather than GNU `cp --parents`: same result, and it is
# the form that can be exercised outside a Linux container.
RUN mkdir -p /manifests && \
    find . -name pyproject.toml -exec sh -c \
      'mkdir -p "/manifests/$(dirname "$1")" && cp "$1" "/manifests/$1"' _ {} \; && \
    cp uv.lock README.md /manifests/ && \
    echo "[manifests] staged $(find /manifests -name pyproject.toml | wc -l) pyproject.toml manifests + uv.lock"

FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim AS deps
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# THE cached layer: manifests only, so its key is uv.lock + the pyproject.toml
# files and nothing else. The source COPYs below re-write these same paths with
# byte-identical content, which is a no-op.
COPY --from=manifests /manifests /app
# Third-party dependencies ONLY — `--no-install-project --no-install-workspace`
# resolves and installs every dependency of the root + all workspace members
# but installs none of the workspace packages themselves (they need source,
# which deliberately is not here yet). The extra list is IDENTICAL to the final
# sync below so the two agree on the resolution (#1806 adds `--inexact` there,
# which changes pruning only, not resolution); see that RUN for why each extra
# is present.
RUN uv sync --frozen --no-dev --no-editable --all-packages \
    --no-install-project --no-install-workspace \
    --extra runtime-temporal --extra runtime-dbos --extra runtime-sqlite \
    --extra storage-postgres --extra runtime-postgres --extra telemetry --extra auth --extra oauth \
    --extra rag --extra pii --extra kernel --extra ssh --extra infisical --extra optuna

# ---- #1806: source-INDEPENDENT heavy installs, ABOVE the source COPYs ----
# These two RUNs install third-party packages ONLY — nothing in them reads a
# line of cairn source. They used to sit after `COPY cairn`, so every deploy,
# including a console-only one with zero Python edits, re-downloaded ~575MB of
# spaCy models and reinstalled CPU torch + lm-eval: a 15-25 min rebuild for a
# one-file change (measured on the prod box 2026-08-30). Hoisted here they key
# only on uv.lock + the manifests, so a source edit reuses them CACHED.
#
# The workspace sync below therefore now runs LAST, and carries `--inexact` so
# it does not prune these as extraneous. uv still removes an extraneous package
# that CONFLICTS with a locked dependency, so the lockfile stays authoritative.

# Bake BOTH spaCy models the PII presets reference: `sm` (the `governed` preset
# DEFAULT — ADR-0079 PII_PRESETS model="sm", tuned for the 2-vCPU box) and `lg`
# (the higher-recall opt-in). The runtime venv has no pip/uv, so a MISSING model
# can't be downloaded at runtime — spaCy `SystemExit`s and the readiness check
# cancels (caught in the 2026-07-20 deploy: only lg was baked, default is sm).
RUN uv pip install --python /app/.venv/bin/python \
    "en_core_web_sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl" \
    "en_core_web_lg @ https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl"

# #898/#909 production tier (opt-in): bake the heavy governed-gate backends the
# `production` profile demands — the lm-eval benchmark harness (model/gate
# require_benchmark), the MLflow registry client (model/register promotion),
# google-re2 fast-PII + datasketch MinHash dedup. OFF by default (dev/demo images
# stay lean); build with `--build-arg PRODUCTION_TIER=1` (compose: set
# PRODUCTION_TIER=1 in .env). torch comes EXPLICITLY from the
# pytorch CPU index first — lm-eval's torch dep on the PyPI default index is the
# CUDA build (~10GB of nvidia wheels) which a CPU control plane can't hold.
# Real training still runs on the training box (finetune-remote → remote/exec →
# cairn-operator-training[local] there) — torch here only serves the eval harness.
ARG PRODUCTION_TIER=0
# CPU torch is the big, slow, source-independent half of the production tier, so
# it is hoisted; the packages that RESOLVE AGAINST THE LOCK are not (see the
# second half, below the workspace sync). torch comes EXPLICITLY from the
# pytorch CPU index — lm-eval's torch dep on the PyPI default index is the CUDA
# build (~10GB of nvidia wheels) which a CPU control plane can't hold.
RUN if [ "$PRODUCTION_TIER" = "1" ]; then \
      uv pip install --python /app/.venv/bin/python \
        --index-url https://download.pytorch.org/whl/cpu torch; \
    fi

# The rest of the tier, installed HERE TOO (#1782). It is installed again below
# the workspace sync, and both runs are needed for different reasons:
#   - this one puts lm-eval/peft/mlflow/transformers — and the tokenizers version
#     they require — in the STABLE layer, so they are not re-exported per deploy;
#   - the one below repairs what the workspace sync disturbs, because uv.lock
#     pins tokenizers 0.22.2 while transformers needs >=0.23.1 (#1783), and the
#     sync would otherwise leave the venv unimportable (#1806 died exactly here).
# The two runs resolve identically, so no distribution CHANGES VERSION across the
# boundary — which is the one thing a layered overlay cannot represent, and which
# the overlay stager refuses rather than papers over.
RUN if [ "$PRODUCTION_TIER" = "1" ]; then \
      uv pip install --python /app/.venv/bin/python \
        "lm-eval>=0.4.0" "peft>=0.11" "mlflow>=2.14" "google-re2>=1.1" "datasketch>=1.6"; \
    fi

# ── #1782 — THE STAGE BOUNDARY, and the reason the final image has two layers ─
# Everything above is third-party and keyed on uv.lock alone; everything below
# is keyed on cairn source. The final stage copies them as SEPARATE layers, so
# a source edit re-exports only the small one. Before this the final stage was a
# single `COPY --from=builder /app/.venv`: one ~3.5GB layer that Docker cannot
# diff inside, so shipping 7MB of changed Python re-exported the whole venv —
# 409s of a ~13 min deploy, measured on the prod box 2026-08-31 (#1782).
#
# The package inventory here is what the overlay is computed against.
RUN uv pip list --python /app/.venv/bin/python --format=json > /deps-dists.json && \
    python3 -c "import json,os;json.dump(sorted(os.listdir('/app/.venv/bin')),open('/deps-bin.json','w'))" && \
    echo "[deps] $(python3 -c 'import json;print(len(json.load(open("/deps-dists.json"))))') distributions in the stable layer"

FROM deps AS builder
WORKDIR /app

# ---- source: everything below re-runs on any source edit (cheap) ----
# The whole workspace must be present: the root depends on its members
# (pyproject [tool.uv.workspace]).
COPY src ./src
# uv workspace members (#1194 cairn-client, #1196 cairn-ask) — `uv sync
# --all-packages` resolves file:// paths for EVERY member, so a missing copy
# fails the whole install plan ("Distribution not found at: file:///app/ask").
# #1253 made the SDK a workspace member — same rule as client/ask above:
# every member must be present or the whole install plan fails.
# ADR-0137 D2 — the engine wheel itself is built from packages/ too: the builtin operator
# packs' import roots and pack.toml files and the core contracts' definitions
# ([tool.hatch.build] in pyproject.toml). They must be here BEFORE the final sync, which
# builds that wheel, or the engine ships without its builtins and its contracts.
COPY packages ./packages
# The example pack is a workspace member too (examples/hello-cairn, #2678): same rule. Without
# it the v0.1.0 public image failed ("Distribution not found at: file:///app/examples/hello-cairn").
COPY examples/hello-cairn ./examples/hello-cairn
# #1190 (ADR-0085 D3): the console SOURCE lives at top-level console/; the wheel
# still ships the built SPA at cairn/web/dist (deployed layout unchanged), so a
# prebuilt console/dist is STAGED there before the install. Building without a
# dist still works — the engine just serves no SPA (same as before the move).
# node_modules never enters the context (.dockerignore).
# Extras so the one image serves every runtime tier (ADR-0035): temporal +
# dbos + the sqlite/postgres checkpointers, plus telemetry + auth. runtime-dbos
# (dbos) and runtime-sqlite (AsyncSqliteSaver/aiosqlite, for HITL pause/resume)
# are required by the dbos-sqlite tier (#34). RAG (llama_index/qdrant) is
# deliberately NOT installed here — it belongs in an operator pack, not the
# engine core (an internal issue).
# --all-packages installs every workspace-member operator pack (builtins +
# official) so their `cairn.operators` entry-points register at runtime.
# Without it, `uv sync` installs only the root package + extras and NO operators
# ship — templates then fail to compile ("No operator registered ... Known:
# (none)"). All operator required-deps are light (datasets, boto3); the heavy
# ones (torch/unsloth/modal/kaggle) are optional extras and stay out.
#
# `rag` IS included so the prod image can index pack knowledge corpora and serve
# `cairn ask` over knowledge (llama-index + fastembed; ~400MB). It stays inert
# unless a knowledge role is used; dense embeddings need an embedder provider —
# set RAG_EMBED_PROVIDER=openai (reuses OPENAI_API_KEY) or =gemini (GEMINI_API_KEY).
# `pii` adds Microsoft Presidio so dataset/anonymize + dataset/pii_scan scrub
# human PII (phone/credit-card/person/location) — the regex fallback only catches
# secrets+email+IP. Presidio needs a spaCy model that is NOT a PyPI dep, so the
# spaCy model RUN above (#1806 hoisted it) installs the pinned wheel into the venv (~560MB; RAM is lazy,
# only allocated when a prep run first inits the analyzer). Drop `--extra pii` +
# the model RUN for a leaner image if PII scrubbing isn't needed.
#
# #1761: the third-party half of this resolution is already installed by the
# manifests-only sync above, so this run normally only BUILDS + installs the
# 41 workspace wheels. The EXTRA list must stay identical to that one — a
# divergence there would make this sync re-download the cached deps.
#
# `--inexact` (#1806): the spaCy models and the production-tier packages are
# now installed ABOVE the source COPYs, so they are already in the venv when
# this runs. Without the flag uv's default exact sync would prune all of them
# as extraneous (they are installed by `uv pip install`, so they are absent
# from uv.lock) and the image would ship with no PII models and no eval tier.
RUN uv sync --frozen --no-dev --no-editable --all-packages --inexact \
    --extra runtime-temporal --extra runtime-dbos --extra runtime-sqlite \
    --extra storage-postgres --extra runtime-postgres --extra telemetry --extra auth --extra oauth \
    --extra rag --extra pii --extra kernel --extra ssh --extra infisical

# #1806 second half — DELIBERATELY below the workspace sync. lm-eval/peft pull
# transformers, whose tokenizers floor (>=0.23.1) is INCOMPATIBLE with the
# tokenizers 0.22.2 that uv.lock pins. Hoisted above the sync, the sync's locked
# tokenizers wins and `import peft` dies at build (caught by the gate below on
# the first #1806 build). Installing after it lets these resolve last, which is
# what the pre-#1806 order did implicitly. They are small next to torch — the
# expensive half stays cached above. The underlying lock/tier disagreement is
# its own problem: see #1783.
RUN if [ "$PRODUCTION_TIER" = "1" ]; then \
      uv pip install --python /app/.venv/bin/python \
        "lm-eval>=0.4.0" "peft>=0.11" "mlflow>=2.14" "google-re2>=1.1" "datasketch>=1.6"; \
    fi

# #1806 — PROVE the hoisted layers survived the sync above, at BUILD time.
# `--inexact` is what keeps them, and its one documented exception is that uv
# still drops an extraneous package that conflicts with a locked dependency. If
# that ever fires, the failure must be a red build here, not a control plane
# that boots fine and then cancels its first PII run — which is exactly how the
# 2026-07-20 missing-spaCy-model incident reached prod. spacy.load() rather than
# an import, because a model absent from the venv is only visible on load.
RUN /app/.venv/bin/python -c "import spacy; spacy.load('en_core_web_sm'); spacy.load('en_core_web_lg'); print('[verify] spaCy sm+lg loadable')"
RUN if [ "$PRODUCTION_TIER" = "1" ]; then \
      /app/.venv/bin/python -c "import torch, mlflow, lm_eval, peft, re2, datasketch; assert '+cpu' in torch.__version__ or not torch.cuda.is_available(), f'production tier torch is not the CPU build: {torch.__version__}'; print('[verify] production tier ok — torch', torch.__version__, 'mlflow', mlflow.__version__)"; \
    fi

# ── #1782 — stage the OVERLAY: what the source half added on top of `deps` ────
# The logic lives in deploy/stage_venv_overlay.py rather than a heredoc here: it
# is the one piece of the split that can be WRONG in a way the image still boots,
# so it has unit tests (tests/core/test_venv_overlay.py) instead of being trusted
# on read. Its contract: metadata-driven (each new distribution's own RECORD), and
# a version-CHANGED distribution is refused rather than layered over.
COPY deploy/stage_venv_overlay.py /tmp/stage_venv_overlay.py
RUN uv pip list --python /app/.venv/bin/python --format=json > /final-dists.json && \
    python3 /tmp/stage_venv_overlay.py /app/.venv \
      /deps-dists.json /final-dists.json /deps-bin.json /overlay

FROM python:3.13-slim-trixie
WORKDIR /app

# #2102 — SkyPilot shells out to `ssh` and `rsync`: for every node it
# provisions or adopts, for `sky ssh up` to register an SSH pool, and (ADR-0104
# D5) for the dataflow engine to fetch `result.json` off a cluster before it is
# torn down. asyncssh is pure Python and does NOT satisfy them — SkyPilot runs
# the real programs. python:3.13-slim-trixie ships neither, so a control plane
# with `cairndev[skypilot]` (cairn-operator-dataflow-skypilot) installed could not launch anything
# (verified in the chart-installed pod on the GPU box: `command -v ssh` →
# nothing). ABOVE the venv COPYs on purpose: this layer's key is the base image
# alone, so it stays cached across every source and dependency change.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client rsync \
    && rm -rf /var/lib/apt/lists/*

# #1782 — TWO layers, ordered by volatility. The first is byte-identical between
# deploys whenever uv.lock is unchanged, so Docker reuses it and exports nothing;
# only the small second layer unpacks on a source edit.
COPY --from=deps    /app/.venv /app/.venv
COPY --from=builder /overlay   /app/.venv

# ── #1782 — verify the ASSEMBLED venv, not the builder's ─────────────────────
# The builder's own gates prove the venv IT built; this image is a different
# artifact — two layers reassembled — so the guarantee has to be re-established
# HERE or the split is taken on trust. The operator count is the load-bearing
# assertion: the workspace wheels are exactly what the overlay carries, and a
# missing entry point is the documented symptom of their absence ("No operator
# registered ... Known: (none)"). A silently thin overlay fails the build.
ARG PRODUCTION_TIER=0
RUN /app/.venv/bin/python -c "\
import importlib.metadata as md, cairn;\
eps = list(md.entry_points(group='cairn.operators'));\
assert len(eps) >= 14, f'only {len(eps)} operator entry points — the overlay is incomplete';\
import spacy; spacy.load('en_core_web_sm');\
print('[verify] assembled venv:', len(eps), 'operators, cairn', getattr(cairn,'__version__','?'), 'spaCy sm ok')"
RUN test -x /app/.venv/bin/cairn-server || (echo "[verify] cairn-server console script missing from the overlay" && exit 1)
# ADR-0137 D2 — the builtin operator packs and the core contracts ship INSIDE the engine wheel:
# every `cairn.operators` entry point is cairndev's, and no builtin pack or core contract package
# is installed as a distribution of its own (it would be a second copy of what cairndev carries).
RUN /app/.venv/bin/python -c "\
import importlib.metadata as md;\
eps = list(md.entry_points(group='cairn.operators'));\
other = sorted({f'{ep.name} ({ep.dist.name})' for ep in eps if ep.dist.name != 'cairndev'});\
assert not other, f'builtin operators not shipped by cairndev: {other}';\
optional = {'cairn-operator-dataflow-metaflow', 'cairn-operator-dataflow-skypilot'};\
names = [d.metadata['Name'] or '' for d in md.distributions()];\
folded = sorted(n for n in names if n.startswith('cairn-contracts-') or (n.startswith('cairn-operator-') and n not in optional));\
assert not folded, f'folded into cairndev (ADR-0137), installed on their own: {folded}';\
print('[verify]', len(eps), 'operators, all from cairndev; no folded distribution installed')"
# #2241 D — the launch door refuses every pipeline reaching an opted-in operator whose
# contract package is not installed, so prove the assembled image RESOLVES them (a built
# image is not enough). The engine wheel hosts the core packages (ADR-0137 D3); their names
# are unchanged.
RUN /app/.venv/bin/python -c "\
from cairn.core.pack.contracts import resolve_contracts;\
names = sorted(d.name for d in resolve_contracts());\
want = {'cairn-contracts-dataflow', 'cairn-contracts-audit', 'cairn-contracts-mcp', 'cairn-contracts-monitor', 'cairn-contracts-artifact', 'cairn-contracts-storage', 'cairn-contracts-memory', 'cairn-contracts-redact', 'cairn-contracts-secrets', 'cairn-contracts-rag', 'cairn-contracts-remote', 'cairn-contracts-data', 'cairn-contracts-train'};\
assert want <= set(names), f'contract distributions resolved: {names}';\
print('[verify] contract distributions resolved:', names)"
# #2102 — the two binaries SkyPilot shells out to. A red build here beats a
# control plane that boots fine and then refuses every `sky` launch at the door.
RUN command -v ssh >/dev/null && command -v rsync >/dev/null \
    || (echo "[verify] ssh/rsync missing — SkyPilot cannot provision or fetch (#2102)" && exit 1)
RUN if [ "$PRODUCTION_TIER" = "1" ]; then \
      /app/.venv/bin/python -c "import torch, mlflow, lm_eval, peft, re2, datasketch; print('[verify] assembled production tier ok')"; \
    fi

# The default profile the start command falls back to: the wheel's packaged `secure` profile
# (redaction + the audit trail on top of local-dev; it binds builtins only, ADR-0134 D5).
RUN test -f /app/.venv/lib/python3.13/site-packages/cairn/profiles/secure.toml \
    || (echo "[verify] the packaged secure profile the CMD defaults to is missing" && exit 1)

# CAIRN_BACKEND (mock) and CAIRN_TRIGGER_PORT (9090) are the code's own defaults. They are
# not baked in as ENV: an image-level CAIRN_* value would shadow a deployment's OBS_* one,
# which is still read until 1.0 (ADR-0122, #2429). For the same reason the profile default is
# applied by the start command, after a deployment's CAIRN_PROFILE and OBS_PROFILE: a bare
# `docker run` starts (the server refuses without a profile, #2296), and any deployment that
# names one keeps it. The bind address is NOT defaulted here: the server binds 0.0.0.0 when
# auth is on and 127.0.0.1 when it is off (#1507), and an image default would open a keyless
# control plane on every published port.
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 9090
CMD ["sh", "-c", "export CAIRN_PROFILE=\"${CAIRN_PROFILE:-${OBS_PROFILE:-/app/.venv/lib/python3.13/site-packages/cairn/profiles/secure.toml}}\" && exec cairn-server"]

# deploy/light/.env — OPTIONAL. The light stack starts with no .env at all;
# copy this file to .env only to change a default. One value per line; keep
# comments on their own line.

# ── Port the console is published on (http://localhost:<port>) ──────────
# CAIRN_PORT=8080

# ── LLM provider key (workflows with an LLM step need one) ───────────────
# OPENAI_API_KEY=sk-...
# CAIRN_BACKEND is the OBSERVABILITY backend (mock = bundled sample telemetry).
# CAIRN_BACKEND=mock

# ── Turn auth on ("deploy for a team"; default: keyless) ────────────────
# CAIRN_JWT_SECRET=<openssl rand -hex 32>
# CAIRN_API_USER=admin
# CAIRN_API_PASSWORD=<choose one>
# Who can sign up: invite (default) | domain | open
# CAIRN_SIGNUP=invite
# How long a remembered console sign-in lasts, in days (default 30)
# CAIRN_REFRESH_TOKEN_DAYS=30

# ── Serve on a domain (Caddy provisions TLS; publish 443 too) ───────────
# CADDY_DOMAIN=cairn.example.com
# Required behind TLS: the browser-facing origin. The sign-in cookie is
# marked Secure only when this is https.
# CAIRN_PUBLIC_URL=https://cairn.example.com

# ── Add-on profiles (see docker-compose.yml) ────────────────────────────
# COMPOSE_PROFILES=llm-gateway,backup
# LITELLM_MASTER_KEY=<openssl rand -hex 24>
# LLM_GATEWAY=proxy
# LLM_GATEWAY_URL=http://litellm:4000
# LLM_GATEWAY_API_KEY=<same as LITELLM_MASTER_KEY>
# CAIRN_BACKUP_INTERVAL_SECONDS=86400
# CAIRN_BACKUP_KEEP=14

# ── Infisical add-on (COMPOSE_PROFILES=infisical) ───────────────────────
# The Infisical server's OWN secrets (encryption key, auth secret, database
# password) do NOT go here: everything in .env reaches the engine container.
# Put them in .env.infisical (copy .env.infisical.example), which only the
# infisical services load.
# INFISICAL_SITE_URL=http://localhost:8085
# The engine reads secrets from it with the prod-infisical profile and a
# machine identity created in the Infisical web UI (universal auth):
# CAIRN_PROFILE=/app/.venv/lib/python3.13/site-packages/cairn/profiles/prod-infisical.toml
# INFISICAL_HOST=http://infisical:8080
# INFISICAL_CLIENT_ID=<machine identity client id>
# INFISICAL_CLIENT_SECRET=<machine identity client secret>
# INFISICAL_PROJECT_ID=<project id>
# INFISICAL_ENVIRONMENT=dev

# ── Postgres password (default: cairn — fine on a laptop, change for a box) ─
# POSTGRES_PASSWORD=<openssl rand -hex 16>

# ── Feature flags: bring a held surface back without leaving light ──────
# CAIRN_FEATURE_DATASETS=on
